{
  "name": "freellmapi",
  "private": true,
  "workspaces": [
    "shared",
    "client"
  ],
  "scripts": {
    "dev": "cargo run -p server",
    "test": "cargo test --workspace",
    "build": "cargo build --release -p server && cd client && bun run build",
    "build:server": "cargo build --release -p server",
    "build:client": "cd client && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "concurrently": "^9.1.2"
  }
}
