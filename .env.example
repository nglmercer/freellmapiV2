# Server encryption key for API key storage (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-64-char-hex-key-here

ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Server port (default: 3001)
PORT=3001

# Keep the server local unless you explicitly need LAN/public access.
BIND_ADDRESS=127.0.0.1

# Optional comma-separated browser origins allowed to call the admin API.
# Leave unset for same-origin access only; add localhost:5173 when using Vite.
# DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The Free endpoint works with Free-tier Artificial Analysis keys.
ARTIFICIAL_ANALYSIS_API_KEY=

# Client-side Vite setting for a local dashboard; do not use in a public build.
# VITE_ADMIN_API_KEY=

# Optional SQLite database path. If unset, an existing server/data/freeapi.db
# is used for compatibility; otherwise data/freeapi.db is created.
# DB_PATH=/var/lib/freellmapi/freeapi.db

# Optional directory containing the built frontend assets.
# STATIC_DIR=client/dist

# Optional tracing filter (for example: info,tower_http=debug)
# RUST_LOG=info
