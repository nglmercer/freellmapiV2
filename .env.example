# FreeLLMAPI runs without a .env file. Every setting below is optional.
#
# Dashboard accounts: the first visit to the dashboard creates the owner
# account. No admin key is needed. API keys for the /v1 endpoint are created
# in the dashboard (Keys page).
#
# Provider-key encryption and the session secret are generated on first start
# and stored in the SQLite database. Set them here only to pin them, for
# example when moving a database to another machine.
#
# ENCRYPTION_KEY=          # 64 hex characters (32 bytes)
# BETTER_AUTH_SECRET=      # at least 32 characters

# Server port (default: 3001)
# PORT=3001

# Keep the server local unless you explicitly need LAN/public access.
# BIND_ADDRESS=127.0.0.1

# Extra dashboard origins allowed to send credentialed requests, comma-separated.
# localhost:5173 and 127.0.0.1:5173 are always allowed for the Vite dev server.
# Only needed when the dashboard is served from a different host than the API.
# DASHBOARD_ORIGINS=http://pi.local:3001

# The Free endpoint works with Free-tier Artificial Analysis keys.
# Optional. Prefer adding this key in the dashboard: Configure providers → Benchmarks.
# ARTIFICIAL_ANALYSIS_API_KEY=

# Optional SQLite database path. Default: data/freeapi.db next to the project.
# DB_PATH=/var/lib/freellmapi/freeapi.db

# Optional directory containing the built frontend assets.
# STATIC_DIR=client/dist

# Optional tracing filter (for example: info,tower_http=debug)
# RUST_LOG=info

# Optional targeted Hub identity metadata. Enable huggingface in Models > Sources.
# Public repository IDs only; no inference requests or Hub-wide scans.
# HUGGINGFACE_METADATA_REPOS=
